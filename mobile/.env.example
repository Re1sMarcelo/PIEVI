# Vazio: descobre o servidor pelo Expo; em túnel usa o proxy /api do Metro.
EXPO_PUBLIC_API_URL=
# Só para fixar um endereço em rede local, substitua pelo IP deste computador:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
# ID OAuth do tipo Web (não Android), criado no mesmo projeto Google Cloud:
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
