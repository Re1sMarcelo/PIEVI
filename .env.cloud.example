# Operacao em nuvem: API no Railway + broker EMQX Cloud. Copie para .env.cloud (fora do Git) e preencha.
# Guia: GUIA-NUVEM.md. Nao cole o .env.cloud preenchido em conversas, issues ou commits.

# Dominio publico do servico da API no Railway (Settings -> Networking -> Generate Domain). Vazio ate o primeiro deploy.
CLOUD_API_URL=

# EMQX Cloud (Deployment Overview): so o endereco, sem mqtts:// e sem porta. Porta TLS padrao 8883.
EMQX_HOST=
EMQX_PORT=8883

# Usuario MQTT da API (EMQX -> Access Control -> Authentication). Client ID unico: uma unica instancia da API.
MQTT_API_USERNAME=pievi-api
MQTT_API_PASSWORD=
MQTT_API_CLIENT_ID=pievi-api-cloud

# Usuario MQTT do ESP32 (gravado no firmware por firmware/tools/gerar-secrets.ps1 -Nuvem).
MQTT_ESP_USERNAME=bancada-01
MQTT_ESP_PASSWORD=
MQTT_ESP_CLIENT_ID=pievi-esp-bancada-01

# Postgres do Railway pela URL publica (scripts no notebook). O servico da API usa a referencia interna.
DATABASE_PUBLIC_URL=
