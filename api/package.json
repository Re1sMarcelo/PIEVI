{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "hash-password": "node scripts/hash-password.mjs",
    "provision:operator": "tsx scripts/provision-operator.ts",
    "db:check": "tsx scripts/check-db.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test:simulator": "node --import tsx tests/simulator-smoke.mjs",
    "test:dashboard": "node --import tsx --test tests/dashboard.test.ts",
    "test:control": "node --import tsx --test tests/control.test.ts",
    "test:auth": "node --import tsx --test tests/auth.test.ts",
    "test:mqtt-contract": "node --import tsx --test tests/mqtt-contract.test.ts",
    "contract:export": "tsx scripts/export-mqtt-contract.ts",
    "contract:check": "tsx scripts/export-mqtt-contract.ts --check",
    "contract:validate": "tsx scripts/validate-mqtt-message.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fastify": "^5.12.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.0.0",
    "typescript": "~6.0.3"
  }
}
