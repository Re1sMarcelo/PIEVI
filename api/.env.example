PORT=3000
PIEVI_DEVICE_MODE=simulator
PIEVI_DEMO_AUTH=1
# Com DATABASE_URL configurada, a autenticação usa o PostgreSQL e ignora
# demo/credenciais de ambiente durante o login. Provisione o operador com:
# npm.cmd run provision:operator -w api
# DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/PIEVI
# Somente no modo isolado SEM DATABASE_URL, para usar credenciais próprias:
# remova PIEVI_DEMO_AUTH e configure:
# OPERATOR_USERNAME=nome-do-operador
# OPERATOR_PASSWORD_HASH=hex-salt:hex-scrypt-hash

# Integração real (servidor PostgreSQL + broker já configurado):
# PIEVI_DEVICE_MODE=mqtt
# DEVICE_ID=bancada-01
# MQTT_URL=mqtt://127.0.0.1:1883
# MQTT_API_USERNAME=api-local
# MQTT_API_PASSWORD=SENHA_DA_API_NO_BROKER
# MQTT_API_CLIENT_ID=pievi-api-local
# MQTT_DEVICE_KIND=virtual
# MQTT_ESP_USERNAME=bancada-01
# MQTT_ESP_PASSWORD=SENHA_DO_ESP_NO_BROKER
# ESP_NVS_PATH=../tmp/esp-virtual/nvs.json
# Não copie credenciais reais para este exemplo. Para testar sem Docker/.env:
# npm.cmd run lab (na raiz; banco e broker próprios do laboratório)
