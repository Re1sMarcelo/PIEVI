{
  "name": "pievi",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "mobile",
    "api"
  ],
  "scripts": {
    "setup:compose": "node api/scripts/setup-compose.mjs",
    "package:delivery": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-delivery.ps1",
    "compose:up": "docker compose --env-file .env.compose up --build -d --wait",
    "compose:down": "docker compose --env-file .env.compose down",
    "validate:compose": "node api/scripts/validate-compose.mjs",
    "dev:mobile": "npm run start -w mobile",
    "dev:api": "npm run dev -w api",
    "lab": "npm run lab -w api",
    "validate:integrated": "npm run validate:integrated -w api",
    "check": "npm run typecheck -w mobile && npm run typecheck -w api",
    "build:api": "npm run build -w api",
    "test:db": "node --test db/tests/schema.test.mjs"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11"
  }
}
